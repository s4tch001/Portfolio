# Copy to .env.local for local dev; set the same three in the Vercel project's
# Production environment before deploying.

# Brevo → Settings → SMTP & API → API Keys (server-only, never exposed)
BREVO_API_KEY=

# Cloudflare dashboard → Turnstile → your widget
# Secret key is server-only; the site key is public by design (NEXT_PUBLIC_).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: protect POST /api/indexnow when triggering IndexNow submissions
# from deploy hooks, CI, or your own admin tools.
INDEXNOW_SUBMIT_TOKEN=

# Turnstile official TEST keys for local dev (always pass, no real challenge):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
